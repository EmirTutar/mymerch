# Kopiere diese Datei zu .env.local und trage die öffentliche URL deines
# deployten Backends ein (z.B. https://mymerch-api.onrender.com).
# Lokal im Dev-Modus kannst du sie leer lassen - dann nutzt Vite den Proxy
# aus vite.config.js und leitet /api automatisch an localhost:8080 weiter.
VITE_API_BASE_URL=
